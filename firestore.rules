rules_version = '2';

// קליקרים — כללי אבטחה
// * רק המנהל שיצר חדר יכול לשנות אותו.
// * משתתף יכול לכתוב רק את הרשומה של עצמו, עם שדות ומגבלות קבועים.
// * משתתף קורא רק את מסמך החדר ואת הרשומה שלו; המנהל קורא את כל המשתתפים.
// * פתיחת חדר רק למנחה עם מנוי בתוקף (licenses), או למנהלת המערכת.
// * את המנויים יוצרת ומעדכנת רק מנהלת המערכת.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function roomData(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }
    function isHost(code) { return signedIn() && roomData(code).hostUid == me(); }

    // מנהלת המערכת: לפי מספר החשבון הקבוע שלה
    function isOwner() {
      return signedIn() && me() == 'MBW1LhCT61ZxnjvhxnjKJnHjuPN2';
    }
    function licPath() { return /databases/$(database)/documents/licenses/$(me()); }
    function licensed() {
      return isOwner() || (signedIn() && exists(licPath())
        && get(licPath()).data.active == true
        && get(licPath()).data.expires > request.time);
    }

    // מנויים: כל מנחה קורא רק את שלו. רק המנהלת יוצרת ומשנה תוקף.
    // הלקוח עצמו יכול לעדכן רק את הסיסמה שהמערכת יצרה לו (pass, passAt).
    match /licenses/{id} {
      allow get: if isOwner() || (signedIn() && me() == id);
      allow list: if isOwner();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (signedIn() && me() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pass', 'passAt'])
        && request.resource.data.pass is string && request.resource.data.pass.size() <= 40)
        // כל משחק שמתחיל: מונה המשחקים עולה ב-1 ונרשם התאריך
        || (signedIn() && me() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays', 'lastPlay', 'lastPlayers', 'games'])
        && request.resource.data.plays == resource.data.get('plays', 0) + 1
        && request.resource.data.lastPlay == request.time
        && request.resource.data.lastPlayers is int && request.resource.data.lastPlayers <= 1000
        && request.resource.data.games is list && request.resource.data.games.size() <= 2000
        && request.resource.data.games.size() == resource.data.get('games', []).size() + 1);
    }

    // פניות מטופס יצירת הקשר באתר: כל אחד יכול לשלוח, רק המנהלת קוראת
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'tel', 'topic', 'msg', 'at', 'done'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 30
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 60
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 2000
        && request.resource.data.at is timestamp
        && request.resource.data.done == false;
      allow read, update, delete: if isOwner();
    }

    // הגדרות ומאגר שאלות של מנהל
    match /hosts/{hostId} {
      allow read, write: if signedIn() && me() == hostId;
    }

    match /rooms/{code} {
      function validRoom(d) {
        return d.hostUid == me()
          && d.status in ['waiting', 'active', 'closed']
          && d.version is int
          && d.duration is int && d.duration >= 5 && d.duration <= 60
          && d.track is string && d.track.size() <= 20
          && d.questions is list && d.questions.size() <= 500
          && d.kicked is list;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[0-9]{6}$') && validRoom(request.resource.data) && licensed();
      allow update: if signedIn() && resource.data.hostUid == me() && validRoom(request.resource.data)
        && (licensed() || request.resource.data.status == 'closed');
      allow delete: if signedIn() && resource.data.hostUid == me();

      match /players/{playerId} {
        function validPlayer(d) {
          return d.keys().hasOnly(['name', 'nameKey', 'avatar', 'online', 'lastSeen', 'score', 'answered',
                                   'total', 'finished', 'version', 'surveys', 'answers'])
            && (!('answers' in d) || (d.answers is map && d.answers.size() <= 500))
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
            && d.nameKey is string && d.nameKey.size() <= 120
            && d.avatar is string && d.avatar.size() <= 40
            && d.score is int && d.score >= 0 && d.score <= 200000
            && d.answered is int && d.answered >= 0 && d.answered <= 1000
            && d.total is int && d.finished is bool && d.online is bool
            && d.version is int && d.surveys is map && d.surveys.size() <= 500;
        }
        function roomOpen() {
          return roomData(code).status != 'closed' && !(me() in roomData(code).kicked);
        }

        allow read: if signedIn() && (me() == playerId || isHost(code));
        allow create, update: if signedIn() && me() == playerId && roomOpen()
          && validPlayer(request.resource.data);
        allow delete: if isHost(code);
      }

      // שריון שמות למניעת שמות כפולים באותו חדר
      match /names/{key} {
        allow get: if signedIn();
        allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == me() && key.size() <= 120;
        allow delete: if signedIn() && (resource.data.uid == me() || isHost(code));
      }
    }
  }
}
